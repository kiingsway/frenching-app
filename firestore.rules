rules_version = '2';

// Regras do projeto sway-apps (valem para TODOS os apps do projeto).
// Publicar com: firebase deploy --only firestore:rules --project sway-apps
// Atenção: publicar substitui as regras do projeto inteiro; mantenha aqui as regras
// dos outros apps também.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administrador do Frenching (sway9king@gmail.com): aprova acessos e cuida das
    // páginas e áudios reportados. Também tem acesso à nuvem sem precisar de aprovação
    function isAdmin() {
      return signedIn() && request.auth.uid == 'xYK4ucxImscP4kdul7sRlk4l0UC2';
    }

    // O Frenching só guarda dados na nuvem de quem foi aprovado
    // (apps/frenching/members/{uid}). Quem não foi usa o app só no computador
    function isFrenchingMember(uid) {
      return isAdmin()
        || exists(/databases/$(database)/documents/apps/frenching/members/$(uid));
    }

    // Quais apps do projeto guardam dados de usuário, e com que condição.
    // Um app que não está aqui não lê nem grava nada, para ninguém usar o banco com um
    // appId inventado. App novo sem controle de usuários: || appId == 'id-do-app'
    function canUseApp(appId, uid) {
      return appId == 'frenching' && isFrenchingMember(uid);
    }

    // Dados de cada usuário, por app: users/{uid}/apps/{appId}/...
    // Cada usuário só lê e grava os próprios dados, nos apps permitidos acima
    match /users/{uid}/apps/{appId}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && canUseApp(appId, uid);
    }

    // Frenching: áudios reportados com um comentário
    // (users/{uid}/apps/frenching/audioReports/{id}).
    // Quem reportou lê e grava pela regra acima; o admin lê, resolve e apaga os de todos.
    // (Substitui as antigas sugestões de troca de voz, audioSuggestions, que o app não usa mais)
    match /{path=**}/audioReports/{reportId} {
      allow read, update, delete: if isAdmin();
    }

    // Frenching: páginas de estudo reportadas com erro
    // (users/{uid}/apps/frenching/pageReports/{id}).
    // Quem reportou grava pela regra de cima; o admin lê, resolve e apaga os de todos
    match /{path=**}/pageReports/{reportId} {
      allow read, update, delete: if isAdmin();
    }

    // Frenching: quem tem acesso à nuvem. Só o admin aprova (cria) e retira (apaga);
    // cada um pode ler só o próprio registro, para o app saber a situação
    match /apps/frenching/members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Frenching: pedidos de acesso. Criados pelo próprio app no primeiro login, sempre
    // como "pending" e com o e-mail da conta; só o admin muda a situação (aprovar/recusar)
    match /apps/frenching/accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'photoURL', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    // Qualquer outro caminho é bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
